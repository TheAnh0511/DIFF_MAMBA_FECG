datasets/**/*.csv
datasets/**/*.mat
datasets/**/*.dat
datasets/**/*.hea
datasets/**/*.edf
datasets/**/*.npy
datasets/**/*.npz
datasets/**/*.pkl
datasets/**/*.pickle
datasets/**/raw/
datasets/**/processed/

# Model checkpoints and weights
checkpoints/
weights/
pretrained_weights/
saved_models/

*.pth
*.pt
*.ckpt
*.onnx
*.h5
*.hdf5

# Training and evaluation outputs
logs/
runs/
outputs/
results/
artifacts/
predictions/
